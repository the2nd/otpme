#: otpme/lib/help/auth.py:21
#, python-brace-format
msgid ""
"Usage: otpme-auth {command} {username} {{password|otp}|{challenge}"
"{response}} [client] [ipaddr]"
msgstr ""
"Uso: otpme-auth {command} {username} {{password|otp}|{challenge}{response}} "
"[client] [ipaddr]"

#: otpme/lib/help/auth.py:24
msgid ""
"Usage: otpme-auth verify [--socket] [--cache <seconds>] [--env-password "
"<VARNAME>] {username} [{password|otp}] [client] [ipaddr]"
msgstr ""
"Uso: otpme-auth verify [--socket] [--cache <seconds>] [--env-password "
"<VARNAME>] {username} [{password|otp}] [client] [ipaddr]"

#: otpme/lib/help/auth.py:27
msgid ""
"Verify clear-text password|otp against valid tokens of user. RECOMMENDED for "
"production: use --env-password instead of the positional password to keep "
"the cleartext out of argv / /proc/<pid>/cmdline."
msgstr ""
"Verificar la contraseña|otp en texto plano contra los tokens válidos del "
"usuario. RECOMENDADO para producción: use --env-password en lugar de la "
"contraseña posicional para mantener el texto plano fuera de argv / /proc/"
"<pid>/cmdline."

#: otpme/lib/help/auth.py:28
msgid ""
"Cache auth request for given seconds. SECURITY NOTE: during the cache "
"lifetime, account-disable, token-revoke, password-change and lockout "
"policies do NOT take effect for cached users -- the daemon is not consulted "
"until the entry expires. Choose a TTL that matches your tolerated revocation "
"delay."
msgstr ""
"Almacenar en caché la solicitud de autenticación durante los segundos "
"indicados. NOTA DE SEGURIDAD: durante la vida útil de la caché, las "
"políticas de deshabilitar cuenta, revocar token, cambiar contraseña y "
"bloqueo NO surten efecto para los usuarios en caché -- no se consulta al "
"daemon hasta que la entrada expire. Elija un TTL que coincida con su retraso "
"de revocación tolerado."

#: otpme/lib/help/auth.py:29
msgid ""
"Read the password from environment variable VARNAME instead of taking it "
"positionally. Place the flag IMMEDIATELY before <username> (e.g. \"otpme-"
"auth verify --env-password User_Password alice nas1\"). With FreeRADIUS "
"rlm_exec this is the safe pattern -- each request attribute is exported as "
"an env var, so %{User-Password} substitution into the program line (which "
"leaks via /proc/<pid>/cmdline) can be avoided entirely."
msgstr ""
"Leer la contraseña de la variable de entorno VARNAME en lugar de tomarla "
"posicionalmente. Coloque la marca INMEDIATAMENTE antes de <username> (por "
"ejemplo, \"otpme-auth verify --env-password User_Password alice nas1\"). Con "
"rlm_exec de FreeRADIUS este es el patrón seguro -- cada atributo de la "
"solicitud se exporta como una variable de entorno, por lo que se puede "
"evitar por completo la sustitución de %{User-Password} en la línea del "
"programa (que se filtra a través de /proc/<pid>/cmdline)."

#: otpme/lib/help/auth.py:30 otpme/lib/help/auth.py:40
msgid "Connect to authd socket."
msgstr "Conectar al socket de authd."

